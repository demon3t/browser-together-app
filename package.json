{
  "name": "browser-together-app",
  "productName": "Browser Together",
  "version": "1.2.0",
  "description": "Browser that streams its tab to the Browser Together Discord activity",
  "main": "main.js",
  "author": "demon3t",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.github.demon3t.browsertogether",
    "productName": "Browser Together",
    "artifactName": "BrowserTogether-Setup.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "generic",
        "url": "https://92-51-44-211.sslip.io/app/"
      }
    ],
    "protocols": [
      {
        "name": "Browser Together",
        "schemes": [
          "browsertogether"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
